<?xml version="1.0" encoding="utf-8"?>
<!-- Two pages stapled at the corner, the back one fanned out around the staple. Same geometry
     as art/stapler-icon.svg. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scales the artwork up slightly, keeping its corners well inside the
         72dp circle the launcher actually shows. -->
    <group
        android:pivotX="53"
        android:pivotY="55"
        android:scaleX="1.08"
        android:scaleY="1.08"
        android:translateX="1"
        android:translateY="-1">
        <!-- Back page -->
        <group
            android:pivotX="41"
            android:pivotY="41.5"
            android:rotation="-10">
            <path
                android:fillColor="#B7C2FF"
                android:pathData="M37,33.5h28a4,4 0,0 1,4 4v38a4,4 0,0 1,-4 4h-28a4,4 0,0 1,-4 -4v-38a4,4 0,0 1,4 -4z" />
        </group>
        <!-- Front page -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M37,33.5h28a4,4 0,0 1,4 4v38a4,4 0,0 1,-4 4h-28a4,4 0,0 1,-4 -4v-38a4,4 0,0 1,4 -4z" />
        <path
            android:pathData="M40,58H62M40,65H62M40,72H54"
            android:strokeColor="#DDE2FF"
            android:strokeLineCap="round"
            android:strokeWidth="3.5" />
        <!-- Staple shadow -->
        <group
            android:pivotX="41"
            android:pivotY="41.5"
            android:rotation="-45"
            android:translateX="0.9"
            android:translateY="1.1">
            <path
                android:fillColor="#D3D9F2"
                android:pathData="M35.4,39.6h11.2a1.9,1.9 0,0 1,0 3.8h-11.2a1.9,1.9 0,0 1,0 -3.8z" />
        </group>
        <!-- Staple: steel body, highlight, and darker ends where it pierces the paper -->
        <group
            android:pivotX="41"
            android:pivotY="41.5"
            android:rotation="-45">
            <path
                android:fillColor="#7D879C"
                android:pathData="M35.4,39.6h11.2a1.9,1.9 0,0 1,0 3.8h-11.2a1.9,1.9 0,0 1,0 -3.8z" />
            <path
                android:pathData="M36,40.6H46"
                android:strokeColor="#E9EDF4"
                android:strokeLineCap="round"
                android:strokeWidth="1" />
            <path
                android:fillColor="#4F576A"
                android:pathData="M34.7,39.6a1.2,1.2 0,0 1,1.2 1.2v1.4a1.2,1.2 0,0 1,-1.2 1.2a1.2,1.2 0,0 1,-1.2 -1.2v-1.4a1.2,1.2 0,0 1,1.2 -1.2z" />
            <path
                android:fillColor="#4F576A"
                android:pathData="M47.3,39.6a1.2,1.2 0,0 1,1.2 1.2v1.4a1.2,1.2 0,0 1,-1.2 1.2a1.2,1.2 0,0 1,-1.2 -1.2v-1.4a1.2,1.2 0,0 1,1.2 -1.2z" />
        </group>
    </group>
</vector>
