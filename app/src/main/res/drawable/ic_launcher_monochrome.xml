<?xml version="1.0" encoding="utf-8"?>
<!-- Single-colour layer for themed icons (Android 13+). Only alpha counts here, so shapes are
     separated by gaps: the back page is clipped away around the front page, and the lines and a
     slot around the staple are cut out of the front page. Clip paths cut holes with an outer
     square plus an inner shape wound the opposite way. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Scales the artwork up slightly, keeping its corners well inside the
         72dp circle the launcher actually shows. -->
    <group
        android:pivotX="53"
        android:pivotY="55"
        android:scaleX="1.08"
        android:scaleY="1.08"
        android:translateX="1"
        android:translateY="-1">
        <!-- Back page, minus a gap around the front page -->
        <group>
            <clip-path android:pathData="M0,0H108V108H0Z M31,31.5V81.5H71V31.5Z" />
            <group
                android:pivotX="41"
                android:pivotY="41.5"
                android:rotation="-10">
                <path
                    android:fillColor="#FFFFFFFF"
                    android:pathData="M37,33.5h28a4,4 0,0 1,4 4v38a4,4 0,0 1,-4 4h-28a4,4 0,0 1,-4 -4v-38a4,4 0,0 1,4 -4z" />
            </group>
        </group>
        <!-- Front page with the text lines and a slot around the staple cut out. The outer group is
             rotated so the slot can be an axis-aligned rectangle; the inner group undoes the turn. -->
        <group
            android:pivotX="41"
            android:pivotY="41.5"
            android:rotation="-45">
            <clip-path android:pathData="M-60,-60H170V170H-60Z M32.3,38.4V44.6H49.7V38.4Z" />
            <group
                android:pivotX="41"
                android:pivotY="41.5"
                android:rotation="45">
                <path
                    android:fillColor="#FFFFFFFF"
                    android:fillType="evenOdd"
                    android:pathData="M37,33.5h28a4,4 0,0 1,4 4v38a4,4 0,0 1,-4 4h-28a4,4 0,0 1,-4 -4v-38a4,4 0,0 1,4 -4z M40,56.25H62V59.75H40Z M40,63.25H62V66.75H40Z M40,70.25H54V73.75H40Z" />
            </group>
        </group>
        <!-- Staple -->
        <group
            android:pivotX="41"
            android:pivotY="41.5"
            android:rotation="-45">
            <path
                android:fillColor="#FFFFFFFF"
                android:pathData="M35.4,39.6h11.2a1.9,1.9 0,0 1,0 3.8h-11.2a1.9,1.9 0,0 1,0 -3.8z" />
        </group>
    </group>
</vector>
